<section class="collections-list section-spacing"><div class="page-width"><div class="page-heading"><p class="eyebrow">The Ababeel edit</p><h1>Shop collections</h1><p>Find the pieces for your next everyday, festive, or wedding-season moment.</p></div><div class="collections-list__grid">{% for collection in collections %}<a class="collection-list-card" href="{{ collection.url }}"><div class="collection-list-card__media">{% if collection.featured_image %}{{ collection.featured_image | image_url: width: 900 | image_tag: widths: '320, 500, 700, 900', loading: 'lazy', alt: collection.title }}{% else %}{{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}{% endif %}</div><div class="collection-list-card__info"><h2>{{ collection.title }}</h2><span>{{ collection.products_count }} pieces <b>↗</b></span></div></a>{% endfor %}</div></div></section>
{% schema %}{ "name": "Collection list", "settings": [] }{% endschema %}
