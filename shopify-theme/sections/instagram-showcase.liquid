<section class="instagram-showcase section-spacing">
  <div class="page-width">
    <div class="section-heading section-heading--split"><div><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div><a class="text-link" href="{{ section.settings.profile_url }}" target="_blank" rel="noopener">@ababeelfashions2024 <span>↗</span></a></div>
    <div class="instagram-grid">
      {% for block in section.blocks %}
        {% assign fallback_image = 'category-women.jpg' %}{% case forloop.index %}{% when 2 %}{% assign fallback_image = 'category-kids.jpg' %}{% when 3 %}{% assign fallback_image = 'category-wedding.jpg' %}{% when 4 %}{% assign fallback_image = 'hero-editorial.jpg' %}{% endcase %}
        <a class="instagram-tile instagram-tile--{{ forloop.index }}" href="{{ block.settings.link | default: section.settings.profile_url }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 620 | image_tag: widths: '240, 400, 620', loading: 'lazy', alt: block.settings.caption }}{% else %}{{ fallback_image | asset_url | image_tag: loading: 'lazy', alt: block.settings.caption }}{% endif %}
          <span class="instagram-tile__overlay"><span class="instagram-tile__handle">@ababeelfashions2024</span><span>{{ block.settings.caption }}</span><b>↗</b></span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Instagram showcase",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Seen on Instagram" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Styled by our community." },
    { "type": "url", "id": "profile_url", "label": "Instagram profile URL", "default": "https://www.instagram.com/ababeelfashions2024/" }
  ],
  "blocks": [{ "type": "post", "name": "Instagram post", "settings": [{ "type": "image_picker", "id": "image", "label": "Image" }, { "type": "text", "id": "caption", "label": "Caption", "default": "A little Ababeel moment" }, { "type": "url", "id": "link", "label": "Post/reel link" }] }],
  "presets": [{ "name": "Instagram showcase", "blocks": [{ "type": "post", "settings": { "caption": "New arrivals" } }, { "type": "post", "settings": { "caption": "Festive dressing" } }, { "type": "post", "settings": { "caption": "Wedding edit" } }, { "type": "post", "settings": { "caption": "Styled your way" } }] }]
}
{% endschema %}
