<section class="featured-collection section-spacing">
  <div class="page-width">
    <div class="section-heading section-heading--split">
      <div><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div>
      {% if section.settings.collection != blank %}<a class="text-link" href="{{ section.settings.collection.url }}">Shop all <span aria-hidden="true">→</span></a>{% endif %}
    </div>
    {% if section.settings.collection != blank and section.settings.collection.products_count > 0 %}
      <div class="product-grid product-grid--{{ section.settings.columns }}">
        {% for product in section.settings.collection.products limit: section.settings.products_to_show %}{% render 'product-card', product: product %}{% endfor %}
      </div>
    {% else %}
      <div class="empty-collection">
        <div class="empty-collection__mark">A</div>
        <h3>Your collection will live here.</h3>
        <p>Choose a collection in the theme editor, then add your latest styles from Shopify Products.</p>
        <a class="button button--outline" href="{{ routes.collections_url }}">Browse all collections</a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Just in" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The pieces everyone is asking for." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 4, "max": 12, "step": 4, "default": 4 },
    { "type": "select", "id": "columns", "label": "Desktop columns", "options": [{ "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }], "default": "4" }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
