<section class="brand-story section-spacing">
  <div class="page-width brand-story__grid{% if section.settings.image == blank %} brand-story__grid--fallback{% endif %}">
    <div class="brand-story__media">
      {% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1100 | image_tag: widths: '480, 720, 960, 1100', loading: 'lazy', alt: section.settings.heading }}{% else %}{{ 'hero-editorial.jpg' | asset_url | image_tag: loading: 'lazy', alt: 'Ababeel Fashions studio story' }}{% endif %}
      <span class="brand-story__label">Since 2024<br><em>Kerala · India</em></span>
    </div>
    <div class="brand-story__copy"><p class="eyebrow">The Ababeel point of view</p><h2>{{ section.settings.heading }}</h2><div class="rte">{{ section.settings.text }}</div><a class="text-link" href="{{ section.settings.button_link | default: pages['about-us'].url | default: '/pages/about-us' }}">{{ section.settings.button_label }} <span>→</span></a></div>
  </div>
</section>

{% schema %}
{
  "name": "Brand story",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ethnic wear, chosen with feeling." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>From our store in Ambalathara to wardrobes across India, Ababeel Fashions is about easy, beautiful pieces that feel right for the moments you show up for.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Our story" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Image" }
  ],
  "presets": [{ "name": "Brand story" }]
}
{% endschema %}
