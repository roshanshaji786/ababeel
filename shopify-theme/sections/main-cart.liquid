<section class="cart-section section-spacing">
  <div class="page-width page-width--narrow">
    <div class="breadcrumbs"><a href="{{ routes.root_url }}">Home</a><span>/</span><span>Cart</span></div>
    <div class="section-heading"><p class="eyebrow">Almost yours</p><h1>Your cart</h1></div>
    {% if cart.item_count > 0 %}
      {% form 'cart', cart, class: 'cart-form' %}
        <div class="cart-items">
          {% for item in cart.items %}
            <div class="cart-item">
              <a class="cart-item__image" href="{{ item.url }}">{% if item.image %}{{ item.image | image_url: width: 300 | image_tag: widths: '120, 180, 300', alt: item.title }}{% else %}{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}{% endif %}</a>
              <div class="cart-item__details"><h2><a href="{{ item.url }}">{{ item.product.title }}</a></h2>{% unless item.product.has_only_default_variant %}<p>{{ item.variant.title }}</p>{% endunless %}<p class="cart-item__price">{{ item.final_line_price | money }}</p><a class="remove-link" href="{{ item.url_to_remove }}">Remove</a></div>
              <div class="quantity-control"><button type="button" data-quantity-minus aria-label="Decrease quantity">−</button><input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantity for {{ item.product.title }}"><button type="button" data-quantity-plus aria-label="Increase quantity">+</button></div>
            </div>
          {% endfor %}
        </div>
        <div class="cart-bottom">
          <div class="cart-note"><label for="CartNote">Order note</label><textarea id="CartNote" name="note" placeholder="Any size or delivery note?">{{ cart.note }}</textarea></div>
          <div class="cart-summary"><div class="cart-summary__line"><span>Subtotal</span><strong>{{ cart.total_price | money }}</strong></div><p>Shipping and taxes are calculated at checkout.</p><button class="button button--dark button--full" type="submit" name="checkout">Continue to checkout <span aria-hidden="true">→</span></button><button type="button" class="button button--whatsapp button--full" data-whatsapp-cart data-whatsapp-number="{{ settings.whatsapp_number | remove: '+' | remove: ' ' }}">Need help ordering? WhatsApp us</button></div>
        </div>
      {% endform %}
    {% else %}
      <div class="empty-collection empty-collection--cart"><div class="empty-collection__mark">A</div><h2>Your cart is waiting for something beautiful.</h2><p>Browse the latest Ababeel styles and find your next favourite.</p><a class="button button--dark" href="{{ routes.collections_url }}">Continue shopping <span aria-hidden="true">→</span></a></div>
    {% endif %}
  </div>
</section>

{% schema %}
{ "name": "Main cart", "settings": [] }
{% endschema %}
