<section class="shop-categories section-spacing">
  <div class="page-width">
    <div class="section-heading section-heading--split"><div><p class="eyebrow">Browse the edit</p><h2>{{ section.settings.heading }}</h2></div><a class="text-link" href="{{ routes.collections_url }}">View all <span aria-hidden="true">→</span></a></div>
    <div class="shop-categories__grid">
      {% for block in section.blocks %}
        <a class="shop-category-card shop-category-card--{{ forloop.index }}" href="{{ block.settings.link | default: routes.collections_url }}" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 900 | image_tag: widths: '320, 500, 700, 900', loading: 'lazy', alt: block.settings.title }}
          {% else %}
            {% case forloop.index %}{% when 1 %}{% assign category_asset = 'category-women.jpg' %}{% when 2 %}{% assign category_asset = 'category-kids.jpg' %}{% when 3 %}{% assign category_asset = 'category-women.jpg' %}{% else %}{% assign category_asset = 'category-wedding.jpg' %}{% endcase %}
            {{ category_asset | asset_url | image_tag: loading: 'lazy', alt: block.settings.title }}
          {% endif %}
          <div class="shop-category-card__shade"></div><div class="shop-category-card__content"><p>{{ block.settings.kicker }}</p><h3>{{ block.settings.title }}</h3><span>Shop now <b>↗</b></span></div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop categories",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Find your next favourite." }],
  "blocks": [{ "type": "category", "name": "Category", "settings": [
    { "type": "text", "id": "kicker", "label": "Small label", "default": "THE EDIT" },
    { "type": "text", "id": "title", "label": "Title", "default": "Women's ethnic wear" },
    { "type": "text", "id": "short_label", "label": "Placeholder label", "default": "WOMEN" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "url", "id": "link", "label": "Link" }
  ] }],
  "presets": [{ "name": "Shop categories", "blocks": [{ "type": "category", "settings": { "kicker": "THE EVERYDAY EDIT", "title": "Women's ethnic wear", "short_label": "WOMEN" } }, { "type": "category", "settings": { "kicker": "FOR LITTLE MOMENTS", "title": "Kids' festive sets", "short_label": "KIDS" } }, { "type": "category", "settings": { "kicker": "MADE FOR YOU", "title": "Custom tailoring", "short_label": "CUSTOM" } }, { "type": "category", "settings": { "kicker": "OCCASION READY", "title": "Wedding edit", "short_label": "WEDDING" } }] }]
}
{% endschema %}
