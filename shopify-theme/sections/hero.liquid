<section class="hero-section section-{{ section.id }}">
  <div class="page-width hero-section__grid{% if section.settings.image == blank %} hero-section__grid--no-image{% endif %}">
    <div class="hero-copy">
      {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      <h1>{{ section.settings.heading }}</h1>
      {% if section.settings.text != blank %}<div class="hero-copy__text">{{ section.settings.text }}</div>{% endif %}
      <div class="hero-actions">
        {% if section.settings.button_label != blank %}<a class="button button--dark" href="{{ section.settings.button_link | default: routes.collections_url }}">{{ section.settings.button_label }} <span aria-hidden="true">↗</span></a>{% endif %}
        {% if section.settings.secondary_label != blank %}<a class="text-link" href="{{ section.settings.secondary_link | default: routes.collections_url }}">{{ section.settings.secondary_label }} <span aria-hidden="true">→</span></a>{% endif %}
      </div>
      <div class="hero-note"><span class="hero-note__dot"></span><span>{{ section.settings.note }}</span></div>
    </div>
    {% if section.settings.image != blank %}
      <div class="hero-media">
        {{ section.settings.image | image_url: width: 1200 | image_tag: widths: '480, 720, 960, 1200', loading: 'eager', class: 'hero-image', alt: section.settings.image.alt | default: section.settings.heading }}
        <div class="hero-media__stamp">Made for<br><em>your moment</em></div>
      </div>
    {% else %}
      <div class="hero-media hero-media--fallback">
        {{ 'hero-editorial.jpg' | asset_url | image_tag: loading: 'eager', class: 'hero-image', alt: 'Ababeel Fashions ethnic wear collection' }}
        <div class="hero-media__stamp">Made for<br><em>your moment</em></div>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Editorial hero",
  "tag": "section",
  "class": "hero-wrapper",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The new festive edit" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Dress for the moments that matter." },
    { "type": "richtext", "id": "text", "label": "Description", "default": "<p>Kerala-ready ethnic wear for weddings, celebrations, and everyday grace — thoughtfully chosen by Ababeel Fashions.</p>" },
    { "type": "text", "id": "button_label", "label": "Primary button label", "default": "Shop the collection" },
    { "type": "url", "id": "button_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary link label", "default": "Explore new arrivals" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" },
    { "type": "text", "id": "note", "label": "Small note", "default": "Premium cotton · Sizes M–XXL · All-India delivery" },
    { "type": "image_picker", "id": "image", "label": "Hero image" }
  ],
  "presets": [{ "name": "Editorial hero" }]
}
{% endschema %}
