<section class="category-section section-spacing">
  <div class="page-width">
    <div class="section-heading section-heading--split">
      <div><p class="eyebrow">Find your look</p><h2>{{ section.settings.heading }}</h2></div>
      <a class="text-link" href="{{ routes.collections_url }}">View all <span aria-hidden="true">→</span></a>
    </div>
    <div class="category-grid">
      {% for block in section.blocks %}
        <a class="category-card" href="{{ block.settings.link | default: routes.collections_url }}" {{ block.shopify_attributes }}>
          <div class="category-card__media">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 800 | image_tag: widths: '320, 480, 640, 800', loading: 'lazy', alt: block.settings.title }}
            {% else %}
              <div class="category-placeholder category-placeholder--{{ forloop.index }}"><span>{{ block.settings.short_label }}</span></div>
            {% endif %}
            <span class="category-card__arrow">↗</span>
          </div>
          <div class="category-card__body"><h3>{{ block.settings.title }}</h3><p>{{ block.settings.description }}</p></div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop by category",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Pieces for every kind of occasion." }],
  "blocks": [
    { "type": "category", "name": "Category", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Women's ethnic wear" },
      { "type": "text", "id": "short_label", "label": "Placeholder label", "default": "WOMEN" },
      { "type": "textarea", "id": "description", "label": "Description", "default": "Easy silhouettes, beautiful details." },
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "url", "id": "link", "label": "Link" }
    ] }
  ],
  "presets": [{ "name": "Shop by category", "blocks": [{ "type": "category", "settings": { "title": "Women's ethnic wear", "short_label": "WOMEN", "description": "Easy silhouettes, beautiful details." } }, { "type": "category", "settings": { "title": "Kids' festive sets", "short_label": "KIDS", "description": "Little looks for big celebrations." } }, { "type": "category", "settings": { "title": "Custom tailoring", "short_label": "CUSTOM", "description": "Made to feel like it belongs to you." } }] }]
}
{% endschema %}
