<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_accent }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <title>
      {{ page_title }}
      {%- if current_tags %} – {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} – Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} – {{ shop.name }}{% endunless -%}
    </title>
    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
    <style>
      :root {
        --color-bg: {{ settings.color_background | default: '#f8f5f0' }};
        --color-surface: {{ settings.color_surface | default: '#fffdf9' }};
        --color-text: {{ settings.color_text | default: '#33252a' }};
        --color-accent: {{ settings.color_accent | default: '#33252a' }};
        --color-accent-light: {{ settings.color_accent_light | default: '#b88c7f' }};
        --color-gold: {{ settings.color_gold | default: '#c59a5c' }};
      }
    </style>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'commerce.css' | asset_url | stylesheet_tag }}
    {{ 'advanced.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="template-{{ template.name | handle }}">
    <a class="skip-link" href="#MainContent">Skip to content</a>
    {% section 'header' %}
    <main id="MainContent" role="main">{{ content_for_layout }}</main>
    {% section 'footer' %}
    {% section 'cart-drawer' %}
    <a class="floating-whatsapp" href="https://wa.me/{{ settings.whatsapp_number | remove: '+' | remove: ' ' }}" target="_blank" rel="noopener" aria-label="Chat with Ababeel Fashions on WhatsApp">
      <span class="floating-whatsapp__icon">⌕</span>
      <span class="floating-whatsapp__text">Chat with us</span>
    </a>
    <script type="application/ld+json">{
      "@context": "https://schema.org",
      "@type": "ClothingStore",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }},
      "logo": {% if settings.logo != blank %}{{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }}{% else %}{{ shop.url | append: '/favicon.ico' | json }}{% endif %},
      "telephone": {{ settings.store_phone | json }},
      "address": { "@type": "PostalAddress", "streetAddress": {{ settings.store_address | strip_newlines | json }}, "addressLocality": "Thiruvananthapuram", "addressRegion": "Kerala", "addressCountry": "IN" },
      "sameAs": [{% if settings.instagram_url != blank %}{{ settings.instagram_url | json }}{% endif %}]
    }</script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  </body>
</html>
