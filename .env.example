# Set in Vercel → Project → Settings → Environment Variables. Never commit real values.
# Added automatically when the Blob store is connected:
BLOB_READ_WRITE_TOKEN=
# scrypt hash of the admin PIN, format "salt:hash" (hex). Generate with: node scripts/hash-pin.mjs <pin>
ADMIN_PIN_HASH=
# Random 32+ byte hex string used to sign admin sessions
SESSION_SECRET=
